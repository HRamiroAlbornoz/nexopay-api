# Base de datos PostgreSQL (Railway provee esta URL al crear la instancia)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Secreto para firmar los JWT — debe ser una cadena larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET=reemplaza_esto_con_un_secreto_largo_y_aleatorio

# Duración del access token (15 minutos recomendado)
JWT_EXPIRES_IN=15m

# Puerto en el que corre el servidor localmente
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# API key de Google Gemini (obtenida en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# URL del frontend — en desarrollo es el puerto de Vite, en producción la URL de Vercel
FRONTEND_URL=http://localhost:5173
